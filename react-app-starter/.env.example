# App Configuration
APP_NAME="Cue Starter"
APP_SLUG=cue-starter
APP_VERSION=1.0.0
APP_SCHEME=cue-starter
ENVIRONMENT=production

# Google Sign-In Configuration
GOOGLE_WEB_CLIENT_ID=your_google_web_client_id_here

# iOS Configuration
IOS_BUNDLE_ID=com.yourcompany.yourapp
IOS_URL_SCHEME=com.googleusercontent.apps.your_client_id

# Android Configuration
ANDROID_PACKAGE=com.yourcompany.yourapp

# Supabase Configuration
# SUPABASE_URL=your_supabase_url
# SUPABASE_ANON_KEY=your_supabase_anon_key

# RevenueCat Configuration (optional)
# REVENUECAT_IOS_KEY=your_revenuecat_ios_api_key_here
# REVENUECAT_ANDROID_KEY=your_revenuecat_android_api_key_here
# REVENUECAT_ENTITLEMENT_ID=premium

# UI Configuration (optional)
# SPLASH_BG_COLOR=#ffffff
# ADAPTIVE_ICON_BG_COLOR=#ffffff
